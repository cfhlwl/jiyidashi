# JiYiDashi production template. Copy to backend/.env.production on the server.
# Never commit the real file or real credentials.
APP_ENV=production
APP_NAME=迹忆 API
DATABASE_URL=postgresql+psycopg://jiyi:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/jiyi
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=jiyidashi-api
JWT_AUDIENCE=jiyidashi-public
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_MINUTES=30
PASSWORD_RESET_MINUTES=30
ENABLE_DEV_AUTH=false
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=[]
OBSERVABILITY_LOG_LEVEL=INFO

# AUTH-03P-A: keep disabled until Alibaba Cloud production activation is
# externally approved. Credentials are server-only secret-manager inputs.
AUTH_SMS_OTP_PROVIDER=disabled
AUTH_SMS_OTP_ALIYUN_ENDPOINT=
AUTH_SMS_OTP_ALIYUN_REGION=
AUTH_SMS_OTP_ALIYUN_SIGN_NAME=
AUTH_SMS_OTP_ALIYUN_TEMPLATE_CODE=
AUTH_SMS_OTP_ALIYUN_CREDENTIAL_SOURCE=environment
AUTH_SMS_OTP_ALIYUN_ACCESS_KEY_ID=
AUTH_SMS_OTP_ALIYUN_ACCESS_KEY_SECRET=
AUTH_SMS_OTP_ALIYUN_TIMEOUT_SECONDS=5

# SEC-017: production human security alert delivery. Never commit a live webhook/secret.
SECURITY_ALERT_HUMAN_PROVIDER=feishu
SECURITY_ALERT_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME_SEC017_WEBHOOK_TOKEN
SECURITY_ALERT_FEISHU_SECRET=CHANGE_ME_SEC017_SIGNING_SECRET
SECURITY_ALERT_DELIVERY_TIMEOUT_SECONDS=5

# NOTIFY-001B: APP-ID-001 is frozen as com.jiyidays. Live providers remain disabled
# until matching Apple/Google/Huawei registrations and credentials are reviewed.
PUSH_APP_IDENTITY_REVIEWED=false
PUSH_IOS_BUNDLE_ID=com.jiyidays
PUSH_ANDROID_APPLICATION_ID=com.jiyidays
PUSH_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PUSH_PROVIDER_READ_TIMEOUT_SECONDS=5
PUSH_PROVIDER_WRITE_TIMEOUT_SECONDS=5
PUSH_PROVIDER_POOL_TIMEOUT_SECONDS=3

APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_FILE=
APNS_TOPIC=com.jiyidays
APNS_ENVIRONMENT=production
APNS_JWT_REFRESH_MINUTES=50

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_PRIVATE_KEY_FILE=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token

HMS_ENABLED=false
HMS_APP_ID=
HMS_CLIENT_ID=
HMS_CLIENT_SECRET=
HMS_OAUTH_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HMS_PUSH_BASE_URL=https://push-api.cloud.huawei.com

DATABASE_READINESS_CONNECT_TIMEOUT_SECONDS=2
DATABASE_READINESS_STATEMENT_TIMEOUT_MS=1500

# OPS-004: bounded SQLAlchemy pool authority for each API process and worker.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECTION_BUDGET=20

# Compose / edge runtime settings.
POSTGRES_DB=jiyi
POSTGRES_USER=jiyi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
WEB_CONCURRENCY=2
API_REQUEST_BODY_LIMIT=2MB

AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_IP_LIMIT=20
AUTH_REGISTER_WINDOW_SECONDS=600
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_IP_LIMIT=8
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BACKOFF_AFTER_FAILURES=3
AUTH_LOGIN_BACKOFF_MAX_SECONDS=60
AUTH_REFRESH_SESSION_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=900
AUTH_VERIFY_RESEND_IP_LIMIT=10
AUTH_VERIFY_RESEND_ACCOUNT_LIMIT=5
AUTH_VERIFY_RESEND_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_IP_LIMIT=10
AUTH_PASSWORD_RESET_ACCOUNT_LIMIT=5
AUTH_PASSWORD_RESET_CONFIRM_LIMIT=10
AUTH_PASSWORD_RESET_WINDOW_SECONDS=3600

# Public authentication email verification and password recovery.
AUTH_EMAIL_DELIVERY_MODE=smtp
AUTH_PUBLIC_BASE_URL=https://app.example.com/auth
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
AUTH_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
AUTH_SMTP_FROM=accounts@example.com
AUTH_SMTP_STARTTLS=true

# Private S3-compatible COS/OSS storage. Never configure a public permanent media URL.
STORAGE_BACKEND=s3
STORAGE_BUCKET=CHANGE_ME_PRIVATE_BUCKET
STORAGE_REGION=CHANGE_ME_REGION
STORAGE_ENDPOINT_URL=https://storage.example.com
STORAGE_ACCESS_KEY_ID=CHANGE_ME_SERVER_ONLY_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_SERVER_ONLY_SECRET_KEY
STORAGE_ADDRESSING_STYLE=virtual
STORAGE_OBJECT_PREFIX=media
STORAGE_PRESIGN_TTL_SECONDS=600
STORAGE_DELETE_SETTLE_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_AUDIO_BYTES=10485760

# API-001: bounded asynchronous user-export generation.
EXPORT_BATCH_SIZE=200
EXPORT_ARTIFACT_MAX_BYTES=268435456
EXPORT_ARTIFACT_TTL_HOURS=24

# OPS-003: private off-host PostgreSQL disaster-recovery authority.
# Use a bucket/container separate from public assets where practical. It must remain private.
BACKUP_OFFHOST_ENABLED=true
BACKUP_STORAGE_BUCKET=CHANGE_ME_PRIVATE_BACKUP_BUCKET
BACKUP_STORAGE_REGION=CHANGE_ME_BACKUP_REGION
BACKUP_STORAGE_ENDPOINT_URL=https://backup-storage.example.com
BACKUP_STORAGE_ACCESS_KEY_ID=CHANGE_ME_BACKUP_SERVER_ONLY_ACCESS_KEY
BACKUP_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_BACKUP_SERVER_ONLY_SECRET_KEY
BACKUP_STORAGE_ADDRESSING_STYLE=virtual
BACKUP_OBJECT_PREFIX=postgresql-backups
BACKUP_SOURCE_CLUSTER_ID=CHANGE_ME_STABLE_CLUSTER_ID
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

# ADMIN-002: server-only master key for encrypted Admin-managed provider credentials.
# Generate a Fernet key; never expose it to browser/mobile/Mini or store it in PostgreSQL.
PROVIDER_CONFIG_MASTER_KEY=CHANGE_ME_FERNET_MASTER_KEY
PROVIDER_CONFIG_CACHE_TTL_SECONDS=2

# SEC-016: authenticated API abuse + cross-worker provider/Argon2 concurrency.
API_RATE_LIMIT_ENABLED=true
API_NORMAL_USER_LIMIT=240
API_NORMAL_IP_LIMIT=480
API_MUTATION_USER_LIMIT=120
API_MUTATION_IP_LIMIT=240
API_MEDIA_USER_LIMIT=60
API_MEDIA_IP_LIMIT=120
API_EXPENSIVE_USER_LIMIT=30
API_EXPENSIVE_IP_LIMIT=60
API_EXPORT_USER_LIMIT=12
API_EXPORT_IP_LIMIT=24
API_RATE_WINDOW_SECONDS=60
PROVIDER_AI_GLOBAL_CONCURRENCY=8
PROVIDER_AI_USER_CONCURRENCY=2
AI_IMAGE_PREPROCESS_GLOBAL_CONCURRENCY=2
AI_IMAGE_PREPROCESS_USER_CONCURRENCY=1
AI_IMAGE_PREPROCESS_PERMIT_LEASE_SECONDS=60
PROVIDER_ASR_GLOBAL_CONCURRENCY=4
PROVIDER_ASR_USER_CONCURRENCY=1
PROVIDER_EMBEDDING_GLOBAL_CONCURRENCY=8
PROVIDER_EMBEDDING_USER_CONCURRENCY=2
PROVIDER_PERMIT_LEASE_SECONDS=180
ARGON2_GLOBAL_CONCURRENCY=4
ARGON2_PERMIT_LEASE_SECONDS=30

ASR_PROVIDER=disabled
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
ASR_TIMEOUT_SECONDS=30
ASR_MIN_CONFIDENCE=0.60

AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=64000
AI_MAX_OUTPUT_TOKENS=4096
AI_IMAGE_MAX_BYTES=2097152
AI_IMAGE_MAX_DIMENSION=2048
AI_IMAGE_MAX_PIXELS=4000000

# S3-009 policy values are server-owned and must stay aligned with app.embedding_policy.
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_INPUT_CHARS=12000

# Server-owned location derivation thresholds.
LOCATION_VISIT_RADIUS_M=120
LOCATION_VISIT_MAX_GAP_SECONDS=1800
LOCATION_VISIT_MIN_DURATION_SECONDS=300
LOCATION_VISIT_MIN_POINTS=2
LOCATION_LATE_ARRIVAL_GRACE_SECONDS=86400
LOCATION_RAW_RETENTION_DAYS=30
LOCATION_FUTURE_SKEW_SECONDS=300
LOCATION_PLACE_GEOHASH_PRECISION=7

# CORE-004: production place naming is centralized on the server through AMap Web Service.
# Replace the placeholder with a Web Service API key; never place it in iOS/Android builds.
PLACE_RESOLVER_PROVIDER=amap
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com/v3
AMAP_WEB_SERVICE_KEY=CHANGE_ME_AMAP_WEB_SERVICE_KEY
AMAP_TIMEOUT_SECONDS=3
PLACE_NAMING_CACHE_TTL_SECONDS=86400
PLACE_NAMING_FAILURE_BACKOFF_SECONDS=300
PLACE_NAMING_CACHE_MAX_ENTRIES=2048
PLACE_NAMING_BACKFILL_BATCH_SIZE=20
