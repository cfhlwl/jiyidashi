# JiYiDashi production template. Copy to backend/.env.production on the server.
# Never commit the real file or real credentials.
APP_ENV=production
APP_NAME=迹忆 API
DATABASE_URL=postgresql+psycopg://jiyi:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/jiyi
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=jiyidashi-api
JWT_AUDIENCE=jiyidashi-public
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_MINUTES=30
PASSWORD_RESET_MINUTES=30
ENABLE_DEV_AUTH=false
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=[]
OBSERVABILITY_LOG_LEVEL=INFO
DATABASE_READINESS_CONNECT_TIMEOUT_SECONDS=2
DATABASE_READINESS_STATEMENT_TIMEOUT_MS=1500

# Compose-only server settings. The API Settings class ignores these extra keys.
POSTGRES_DB=jiyi
POSTGRES_USER=jiyi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
WEB_CONCURRENCY=2

AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_IP_LIMIT=20
AUTH_REGISTER_WINDOW_SECONDS=600
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_IP_LIMIT=8
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BACKOFF_AFTER_FAILURES=3
AUTH_LOGIN_BACKOFF_MAX_SECONDS=60
AUTH_REFRESH_SESSION_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=900
AUTH_VERIFY_RESEND_IP_LIMIT=10
AUTH_VERIFY_RESEND_ACCOUNT_LIMIT=5
AUTH_VERIFY_RESEND_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_IP_LIMIT=10
AUTH_PASSWORD_RESET_ACCOUNT_LIMIT=5
AUTH_PASSWORD_RESET_CONFIRM_LIMIT=10
AUTH_PASSWORD_RESET_WINDOW_SECONDS=3600

# Public authentication email verification and password recovery.
AUTH_EMAIL_DELIVERY_MODE=smtp
AUTH_PUBLIC_BASE_URL=https://app.example.com/auth
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
AUTH_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
AUTH_SMTP_FROM=accounts@example.com
AUTH_SMTP_STARTTLS=true

# Private S3-compatible COS/OSS storage. Never configure a public permanent media URL.
STORAGE_BACKEND=s3
STORAGE_BUCKET=CHANGE_ME_PRIVATE_BUCKET
STORAGE_REGION=CHANGE_ME_REGION
STORAGE_ENDPOINT_URL=https://storage.example.com
STORAGE_ACCESS_KEY_ID=CHANGE_ME_SERVER_ONLY_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_SERVER_ONLY_SECRET_KEY
STORAGE_ADDRESSING_STYLE=virtual
STORAGE_OBJECT_PREFIX=media
STORAGE_PRESIGN_TTL_SECONDS=600
STORAGE_DELETE_SETTLE_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_AUDIO_BYTES=10485760

# ADMIN-002: server-only master key for encrypted Admin-managed provider credentials.
# Generate a Fernet key; never expose it to browser/mobile/Mini or store it in PostgreSQL.
PROVIDER_CONFIG_MASTER_KEY=
PROVIDER_CONFIG_CACHE_TTL_SECONDS=2

ASR_PROVIDER=disabled
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
ASR_TIMEOUT_SECONDS=30
ASR_MIN_CONFIDENCE=0.60

AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=64000
AI_MAX_OUTPUT_TOKENS=4096

# S3-009 policy values are server-owned and must stay aligned with app.embedding_policy.
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_INPUT_CHARS=12000

# Server-owned location derivation thresholds.
LOCATION_VISIT_RADIUS_M=120
LOCATION_VISIT_MAX_GAP_SECONDS=1800
LOCATION_VISIT_MIN_DURATION_SECONDS=300
LOCATION_VISIT_MIN_POINTS=2
LOCATION_LATE_ARRIVAL_GRACE_SECONDS=86400
LOCATION_RAW_RETENTION_DAYS=30
LOCATION_FUTURE_SKEW_SECONDS=300
LOCATION_PLACE_GEOHASH_PRECISION=7

# CORE-004: production place naming is centralized on the server through AMap Web Service.
# Replace the placeholder with a Web Service API key; never place it in iOS/Android builds.
PLACE_RESOLVER_PROVIDER=amap
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com/v3
AMAP_WEB_SERVICE_KEY=CHANGE_ME_AMAP_WEB_SERVICE_KEY
AMAP_TIMEOUT_SECONDS=3
PLACE_NAMING_CACHE_TTL_SECONDS=86400
PLACE_NAMING_FAILURE_BACKOFF_SECONDS=300
PLACE_NAMING_CACHE_MAX_ENTRIES=2048
PLACE_NAMING_BACKFILL_BATCH_SIZE=20
