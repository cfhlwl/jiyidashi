# [人工注释][FND-019] 示例配置默认关闭开发认证；仅本地开发时手动改为 true，生产环境永远禁止开启。
APP_ENV=development
APP_NAME=迹忆 API
DATABASE_URL=sqlite:///./jiyi.db
JWT_SECRET=change-this-in-real-environments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080
ENABLE_DEV_AUTH=false
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
OBSERVABILITY_LOG_LEVEL=INFO
DATABASE_READINESS_CONNECT_TIMEOUT_SECONDS=2
DATABASE_READINESS_STATEMENT_TIMEOUT_MS=1500

# AUTH-03P-A: server-side SMS provider is disabled by default. Never put these
# values in Flutter/mobile configuration. Enable only with approved Alibaba
# Cloud sign/template, quota, and credential deployment prerequisites.
AUTH_SMS_OTP_PROVIDER=disabled
AUTH_SMS_OTP_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
AUTH_SMS_OTP_ALIYUN_REGION=
AUTH_SMS_OTP_ALIYUN_SIGN_NAME=
AUTH_SMS_OTP_ALIYUN_TEMPLATE_CODE=
AUTH_SMS_OTP_ALIYUN_CREDENTIAL_SOURCE=environment
AUTH_SMS_OTP_ALIYUN_ACCESS_KEY_ID=
AUTH_SMS_OTP_ALIYUN_ACCESS_KEY_SECRET=
AUTH_SMS_OTP_ALIYUN_TIMEOUT_SECONDS=5

# AUTH-04B1: server-side OAuth adapter is disabled by default. Keep the live gate
# false until Open Platform registration and server-side AppSecret delivery are
# separately approved; B2/B3 native SDK work remains a later phase.
AUTH_WECHAT_PROVIDER=disabled
AUTH_WECHAT_LIVE_ENABLED=false
AUTH_WECHAT_APP_ID=
AUTH_WECHAT_APP_SECRET=
AUTH_WECHAT_SUBJECT_SCOPE=
AUTH_WECHAT_API_BASE_URL=https://api.weixin.qq.com
AUTH_WECHAT_FINGERPRINT_SECRET=
AUTH_WECHAT_FINGERPRINT_KEY_VERSION=v1
AUTH_WECHAT_TIMEOUT_SECONDS=5
AUTH_WECHAT_MAX_RESPONSE_BYTES=65536

# [人工注释][S1-006] 媒体默认 fail closed；生产接 COS/OSS 私有桶时启用 s3 SigV4 兼容配置，禁止设置公开永久 URL。
STORAGE_BACKEND=disabled
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ADDRESSING_STYLE=virtual
STORAGE_OBJECT_PREFIX=media
STORAGE_PRESIGN_TTL_SECONDS=600
# [人工注释][S1-021-FIX-002] 必须覆盖对象存储/代理允许的最大 in-flight PUT 生命周期；
# Data Delete 会在旧签名过期后再持续等待此 settle window，期间出现 late object 会重新计时。
STORAGE_DELETE_SETTLE_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_AUDIO_BYTES=10485760

# ADMIN-002: server-only master key for encrypted Admin-managed provider credentials.
# Generate a Fernet key; never expose it to browser/mobile/Mini or store it in PostgreSQL.
PROVIDER_CONFIG_MASTER_KEY=
PROVIDER_CONFIG_CACHE_TTL_SECONDS=2

# SEC-016: authenticated API abuse + cross-worker provider/Argon2 concurrency.
API_RATE_LIMIT_ENABLED=true
API_NORMAL_USER_LIMIT=240
API_NORMAL_IP_LIMIT=480
API_MUTATION_USER_LIMIT=120
API_MUTATION_IP_LIMIT=240
API_MEDIA_USER_LIMIT=60
API_MEDIA_IP_LIMIT=120
API_EXPENSIVE_USER_LIMIT=30
API_EXPENSIVE_IP_LIMIT=60
API_EXPORT_USER_LIMIT=12
API_EXPORT_IP_LIMIT=24
API_RATE_WINDOW_SECONDS=60
PROVIDER_AI_GLOBAL_CONCURRENCY=8
PROVIDER_AI_USER_CONCURRENCY=2
PROVIDER_ASR_GLOBAL_CONCURRENCY=4
PROVIDER_ASR_USER_CONCURRENCY=1
PROVIDER_EMBEDDING_GLOBAL_CONCURRENCY=8
PROVIDER_EMBEDDING_USER_CONCURRENCY=2
PROVIDER_PERMIT_LEASE_SECONDS=180
ARGON2_GLOBAL_CONCURRENCY=4
ARGON2_PERMIT_LEASE_SECONDS=30

# [人工注释][S1-007] ASR 默认关闭；启用时密钥只配置在后端。当前 provider=openai 使用
# /v1/audio/transcriptions + logprobs 派生服务端置信度，低于 ASR_MIN_CONFIDENCE 不创建 Memory。
ASR_PROVIDER=disabled
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
ASR_TIMEOUT_SECONDS=30
ASR_MIN_CONFIDENCE=0.60

# [人工注释][S3-001] Stage 3 AI Gateway 默认关闭。启用 provider 时 key/model 仅放后端，
# 后续 Memory Pipeline / Intent Router 只能调用 Gateway，客户端不得直连模型厂商。
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=64000
AI_MAX_OUTPUT_TOKENS=4096

# [人工注释][S3-009] Embedding provider 仍只在服务端；模型/维度必须匹配已审查 policy。
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_INPUT_CHARS=12000

# [人工注释][S1-FIX-003] 正式注册/登录默认开启数据库级滥用保护；生产环境禁止关闭。
AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_IP_LIMIT=20
AUTH_REGISTER_WINDOW_SECONDS=600
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_IP_LIMIT=8
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BACKOFF_AFTER_FAILURES=3
AUTH_LOGIN_BACKOFF_MAX_SECONDS=60

# [人工注释][S2-006~S2-014] 位置批量同步/Visit 派生只在服务端使用这些阈值。
# raw retention 必须长于 late-arrival grace + Visit gap，避免先删证据再定稿派生事实。
LOCATION_VISIT_RADIUS_M=120
LOCATION_VISIT_MAX_GAP_SECONDS=1800
LOCATION_VISIT_MIN_DURATION_SECONDS=300
LOCATION_VISIT_MIN_POINTS=2
LOCATION_LATE_ARRIVAL_GRACE_SECONDS=86400
LOCATION_RAW_RETENTION_DAYS=30
LOCATION_FUTURE_SKEW_SECONDS=300
LOCATION_PLACE_GEOHASH_PRECISION=7

# CORE-004 server-side place naming. Mobile clients must never receive this key.
# Development stays disabled unless an AMap Web Service key is explicitly supplied.
PLACE_RESOLVER_PROVIDER=disabled
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com/v3
AMAP_WEB_SERVICE_KEY=
AMAP_TIMEOUT_SECONDS=3
PLACE_NAMING_CACHE_TTL_SECONDS=86400
PLACE_NAMING_FAILURE_BACKOFF_SECONDS=300
PLACE_NAMING_CACHE_MAX_ENTRIES=2048
PLACE_NAMING_BACKFILL_BATCH_SIZE=20
