{
    email {$ACME_EMAIL}
    servers {
        timeouts {
            read_body 2m
            read_header 10s
            write 2m
            idle 2m
        }
    }
}

http://{$API_DOMAIN} {
    redir https://{$API_DOMAIN}{uri} permanent
}

https://{$API_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
    }

    request_body {
        max_size {$API_REQUEST_BODY_LIMIT}
    }

    respond /health/ready 404

    redir /admin /admin/ permanent

    handle /admin/api/* {
        reverse_proxy api:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
                keepalive 30s
            }
        }
    }

    handle_path /admin/* {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }

    reverse_proxy api:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
            keepalive 30s
        }
    }
}
